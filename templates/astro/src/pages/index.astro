---
import "../styles/theme.css";

const nav = [
  { href: "/product", label: "Product" },
  { href: "/pricing", label: "Pricing" },
  { href: "/docs", label: "Docs" },
  { href: "/changelog", label: "Changelog" },
];

const features = [
  { title: "Latency", copy: "p95 per route, per region, per release." },
  { title: "Cohorts", copy: "Retention by first action, not by signup date." },
  { title: "Incidents", copy: "Impact in revenue and users, written during the incident." },
  { title: "Cost", copy: "Storage and compute per tenant, before the invoice." },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Meridian - Usage analytics for platform teams</title>
    <meta
      name="description"
      content="Meridian turns raw product events into revenue, retention and reliability signals your platform team can act on the same day."
    />
    <link rel="canonical" href="https://meridian.example/" />
  </head>

  <body class="nv-aurora-host">
    <!-- The aurora and grain layers are the background every glass surface reads from. -->
    <div class="nv-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="nv-grain" aria-hidden="true"></div>

    <a class="skip" href="#main">Skip to content</a>

    <header class="nv-nav">
      <div class="nv-container nv-nav-inner">
        <a class="brand" href="/">
          <span class="brand-mark">M</span>
          Meridian
        </a>
        <nav class="nv-nav-links" aria-label="Main">
          {nav.map((item, index) => (
            <a href={item.href} aria-current={index === 0 ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="nv-nav-actions">
          <a class="nv-btn nv-btn-glass" href="/login">Sign in</a>
          <a class="nv-btn nv-btn-primary" href="/signup">
            Start free
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="nv-hero">
        <div class="nv-container nv-hero-grid">
          <div>
            <p class="nv-pill nv-reveal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3l1.9 4.6 4.6 1.9-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3Z" />
              </svg>
              Event pipeline 2.0 is out
            </p>

            <h1 class="nv-display nv-grad-text nv-reveal" style="--nv-delay: 80ms">Know what your product actually does</h1>

            <p class="nv-lead nv-reveal" style="--nv-delay: 200ms">
              Meridian reads one stream of product events and answers three questions the same minute:
              what changed, who it affects, and what it costs. No instrumentation sprint, no warehouse
              project.
            </p>

            <div class="nv-actions nv-reveal" style="--nv-delay: 320ms">
              <a class="nv-btn nv-btn-primary nv-btn-lg" href="/signup">
                Start free
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
              <a class="nv-btn nv-btn-glass nv-btn-lg" href="/demo">Book a 20 minute demo</a>
            </div>

            <ul class="nv-trust nv-reveal" style="--nv-delay: 420ms">
              <li>No credit card</li>
              <li>SOC 2 Type II</li>
              <li>EU data residency</li>
            </ul>
          </div>

          <div class="nv-reveal" style="--nv-delay: 480ms">
            <div class="nv-surface nv-lift-lg" style="padding: 8px">
              <div class="nv-inset" style="background: var(--bg-soft)">
                <div class="preview-top">
                  <span class="dot"></span><span class="dot"></span>
                  <span class="preview-url">app.meridian/overview</span>
                  <span class="preview-time">14:02 UTC</span>
                </div>
                <div class="preview-metrics">
                  <div><p>Net revenue</p><strong>$412.8k</strong><span class="up">+6.2%</span></div>
                  <div><p>Active accounts</p><strong>8,914</strong><span class="up">+1.4%</span></div>
                  <div><p>p95 latency</p><strong>184ms</strong><span class="up">-12ms</span></div>
                </div>
                <svg class="preview-chart" viewBox="0 0 320 84" role="img" aria-label="Revenue over thirty days">
                  <defs>
                    <linearGradient id="astro-fill" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#7c8cff" stop-opacity="0.3" />
                      <stop offset="100%" stop-color="#7c8cff" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <path d="M0 62 L32 58 L64 60 L96 44 L128 48 L160 32 L192 36 L224 22 L256 26 L288 14 L320 18 L320 84 L0 84 Z" fill="url(#astro-fill)" />
                  <polyline points="0,62 32,58 64,60 96,44 128,48 160,32 192,36 224,22 256,26 288,14 320,18" fill="none" stroke="#7c8cff" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="nv-band">
        <div class="nv-container">
          <p class="nv-logos">Northwind &middot; Aperture &middot; Kestrel Labs &middot; Solstice &middot; Ravel &middot; Trema</p>
        </div>
      </section>

      <section class="nv-section">
        <div class="nv-container">
          <header class="nv-section-header">
            <p class="nv-overline">Platform</p>
            <h2 class="nv-h2">One pipeline, three questions answered</h2>
            <p class="nv-section-lead">
              Everything below reads the same event stream, so a number in the dashboard and a line in
              the incident report can never disagree.
            </p>
          </header>

          <div class="nv-grid-2">
            <div class="nv-surface nv-surface-strong nv-reveal" style="padding: 28px">
              <p class="nv-kicker">Revenue signals</p>
              <p class="nv-h3">Attribute every change to a cohort, a release or a region</p>
              <p class="nv-body">
                Meridian keeps 400 days of raw events and 400 days of aggregates side by side, so a
                question about last March does not become a backfill job.
              </p>
              <div class="nv-bars" aria-hidden="true">
                {[38, 52, 44, 68, 60, 78, 71, 88].map((height) => (
                  <span style={{ height: `${height}%` }}></span>
                ))}
              </div>
            </div>

            <div class="nv-grid-cards">
              {features.map((feature, index) => (
                <article class="nv-surface nv-lift nv-reveal" style={`--nv-delay: ${index * 60}ms`}>
                  <p class="nv-card-title">{feature.title}</p>
                  <p class="nv-card-copy">{feature.copy}</p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="nv-section">
        <div class="nv-container">
          <div class="nv-surface" style="padding: 32px">
            <div class="nv-metrics">
              <div><strong data-count="4.2" data-decimals="1" data-suffix="B">0</strong><p>Events processed daily</p></div>
              <div><strong data-count="180" data-suffix="ms">0</strong><p>Median query time</p></div>
              <div><strong data-count="1240">0</strong><p>Teams shipping on Meridian</p></div>
            </div>
          </div>
        </div>
      </section>

      <section class="nv-section">
        <div class="nv-container">
          <div class="nv-cta nv-surface nv-surface-strong">
            <h2 class="nv-h1">Start with one week of events. Keep the rest for free.</h2>
            <p class="nv-body" style="max-width: 52ch; margin: 16px auto 0">
              Import a sample or your own stream. The trial does not expire, and the thirty day window
              becomes permanent on the first paid month.
            </p>
            <div class="nv-actions" style="justify-content: center; margin-top: 28px">
              <a class="nv-btn nv-btn-primary nv-btn-lg" href="/signup">Create a workspace</a>
              <a class="nv-btn nv-btn-glass nv-btn-lg" href="/docs/quickstart">Read the quickstart</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="nv-footer">
      <div class="nv-container nv-footer-grid">
        <div>
          <p class="brand"><span class="brand-mark">M</span> Meridian</p>
          <p class="nv-body" style="max-width: 34ch">
            Usage analytics for platform teams. One event stream, one metric definition, one place to
            look.
          </p>
        </div>
        <nav aria-label="Product">
          <p class="nv-overline">Product</p>
          <a href="/product">Overview</a>
          <a href="/pricing">Pricing</a>
          <a href="/changelog">Changelog</a>
        </nav>
        <nav aria-label="Developers">
          <p class="nv-overline">Developers</p>
          <a href="/docs/quickstart">Quickstart</a>
          <a href="/docs/api">API reference</a>
          <a href="/docs/sdks">SDKs</a>
        </nav>
        <nav aria-label="Company">
          <p class="nv-overline">Company</p>
          <a href="/customers">Customers</a>
          <a href="/security">Security</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
      <div class="nv-container nv-footer-legal">
        <p>2026 Meridian. All rights reserved.</p>
        <p>Designed with the Nova Vitral system</p>
      </div>
    </footer>

    <script>
      // Reveal: one shared observer, fires once, no motion when the visitor asked for none.
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const targets = document.querySelectorAll(".nv-reveal");

      if (reduce) {
        targets.forEach((node) => node.classList.add("nv-in"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("nv-in");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.25 },
        );
        targets.forEach((node) => observer.observe(node));
      }

      // Counters: count once at 50 percent visibility.
      const counters = document.querySelectorAll("[data-count]");
      const countObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const node = entry.target;
          const target = Number(node.dataset.count);
          const decimals = Number(node.dataset.decimals || 0);
          const suffix = node.dataset.suffix || "";
          if (reduce) {
            node.textContent = target.toFixed(decimals) + suffix;
            return;
          }
          const start = performance.now();
          const tick = (now) => {
            const progress = Math.min((now - start) / 1200, 1);
            const value = target * (1 - Math.pow(1 - progress, 3));
            node.textContent = value.toFixed(decimals) + suffix;
            if (progress < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
          countObserver.unobserve(node);
        });
      }, { threshold: 0.5 });
      counters.forEach((node) => countObserver.observe(node));

      // Navbar: condense after 24px, one passive listener.
      const header = document.querySelector(".nv-nav");
      const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 24);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    </script>

    <style is:global>
      .nv-aurora-host { background: var(--bg); color: var(--fg); font-family: var(--font-sans); margin: 0; }
      .skip { position: absolute; left: -9999px; }
      .skip:focus { left: 16px; top: 16px; z-index: 100; padding: 8px 12px; border-radius: var(--radius-sm); background: var(--glass-strong); }
      .nv-nav { position: fixed; inset: 0 0 auto 0; z-index: var(--z-nav); height: var(--nav-h); border-bottom: 1px solid transparent; transition: all 240ms var(--ease-out); }
      .nv-nav.is-scrolled { height: 56px; border-bottom-color: var(--hair); background: color-mix(in srgb, var(--bg) 74%, transparent); backdrop-filter: blur(var(--blur-md)); }
      .nv-nav-inner { display: flex; align-items: center; gap: 16px; height: 100%; }
      .brand { display: inline-flex; align-items: center; gap: 8px; font-size: var(--fs-sm); font-weight: 600; color: var(--fg); text-decoration: none; }
      .brand-mark { display: grid; place-items: center; width: 28px; height: 28px; border-radius: var(--radius-sm); border: 1px solid var(--hair); background: var(--glass); font-size: var(--fs-2xs); }
      .nv-nav-links { display: none; gap: 4px; margin-left: 16px; }
      .nv-nav-links a { padding: 8px 12px; border-radius: var(--radius-sm); font-size: var(--fs-sm); color: var(--fg-muted); text-decoration: none; transition: color 150ms var(--ease-out); }
      .nv-nav-links a:hover, .nv-nav-links a[aria-current="page"] { color: var(--fg); }
      .nv-nav-actions { margin-left: auto; display: flex; gap: 8px; }
      .nv-hero { padding: calc(var(--nav-h) + 72px) 0 96px; }
      .nv-hero-grid { display: grid; gap: 48px; align-items: center; }
      .nv-pill { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--hair); background: var(--glass-dim); font-size: 12px; color: var(--fg-muted); }
      .nv-pill svg { width: 14px; height: 14px; color: var(--accent); }
      .nv-display { margin: 20px 0 0; font-size: clamp(38px, 6vw, 68px); line-height: 0.98; letter-spacing: -0.04em; font-weight: 600; max-width: 19ch; }
      .nv-lead { margin: 24px 0 0; max-width: 50ch; font-size: var(--fs-lead); line-height: 1.7; color: var(--fg-muted); }
      .nv-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
      .nv-trust { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 32px 0 0; padding: 0; list-style: none; font-size: 13px; color: var(--fg-subtle); }
      .nv-band { border-block: 1px solid var(--hair); padding: 32px 0; }
      .nv-logos { margin: 0; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-subtle); }
      .nv-section { padding: 96px 0; }
      .nv-section-header { max-width: 62ch; margin-bottom: 40px; }
      .nv-overline { margin: 0 0 12px; font-size: var(--fs-2xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--fg-subtle); }
      .nv-h2 { margin: 0; font-size: clamp(28px, 3.4vw, 40px); letter-spacing: -0.025em; font-weight: 600; }
      .nv-h1 { margin: 0; font-size: clamp(30px, 4vw, 50px); letter-spacing: -0.03em; font-weight: 600; }
      .nv-h3 { margin: 16px 0 0; font-size: clamp(20px, 2.2vw, 26px); letter-spacing: -0.02em; font-weight: 600; }
      .nv-kicker { margin: 0; font-size: 13px; color: var(--accent); }
      .nv-body { font-size: 15px; line-height: 1.75; color: var(--fg-muted); }
      .nv-section-lead { margin: 16px 0 0; font-size: var(--fs-lead); line-height: 1.7; color: var(--fg-muted); }
      .nv-grid-2 { display: grid; gap: 16px; }
      .nv-grid-cards { display: grid; gap: 16px; }
      .nv-card-title { margin: 0; font-size: 15px; font-weight: 600; }
      .nv-card-copy { margin: 8px 0 0; font-size: 13.5px; line-height: 1.65; color: var(--fg-muted); }
      .nv-bars { display: flex; align-items: flex-end; gap: 8px; height: 96px; margin-top: 24px; }
      .nv-bars span { flex: 1; border-radius: 3px 3px 0 0; background: linear-gradient(180deg, var(--accent), rgba(124, 140, 255, 0.25)); }
      .nv-metrics { display: grid; gap: 32px; }
      .nv-metrics strong { display: block; font-size: clamp(30px, 4vw, 46px); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
      .nv-metrics p { margin: 8px 0 0; font-size: 13px; color: var(--fg-muted); }
      .nv-cta { padding: 56px 32px; text-align: center; }
      .nv-footer { margin-top: 96px; border-top: 1px solid var(--hair); padding: 56px 0 24px; }
      .nv-footer-grid { display: grid; gap: 32px; }
      .nv-footer a { display: block; margin-top: 10px; font-size: 13.5px; color: var(--fg-muted); text-decoration: none; transition: color 150ms var(--ease-out); }
      .nv-footer a:hover { color: var(--fg); }
      .nv-footer-legal { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--hair-soft); font-size: 12px; color: var(--fg-subtle); }
      .preview-top { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-bottom: 1px solid var(--hair); }
      .dot { width: 8px; height: 8px; border-radius: 999px; background: var(--hair-strong); }
      .preview-url { margin-left: 8px; font-size: 12px; color: var(--fg-subtle); }
      .preview-time { margin-left: auto; font-size: 11px; color: var(--fg-subtle); }
      .preview-metrics { display: grid; gap: 12px; padding: 12px; }
      .preview-metrics > div { border: 1px solid var(--hair); background: var(--glass-dim); border-radius: var(--radius-sm); padding: 12px; }
      .preview-metrics p { margin: 0; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--fg-subtle); }
      .preview-metrics strong { display: block; margin-top: 6px; font-size: 17px; font-variant-numeric: tabular-nums; }
      .preview-metrics .up { font-size: 11.5px; color: var(--accent-2); }
      .preview-chart { display: block; width: 100%; height: 96px; padding: 0 12px 12px; }
      .nv-lift-lg { transition: transform 240ms var(--ease-out), box-shadow 240ms var(--ease-out); }
      .nv-lift-lg:hover { transform: translateY(-2px); }

      @media (min-width: 768px) {
        .nv-grid-cards { grid-template-columns: repeat(2, 1fr); }
        .preview-metrics { grid-template-columns: repeat(3, 1fr); }
        .nv-metrics { grid-template-columns: repeat(3, 1fr); }
        .nv-footer-grid { grid-template-columns: 1.4fr repeat(3, 1fr); }
      }

      @media (min-width: 1024px) {
        .nv-nav-links { display: flex; }
        .nv-hero-grid { grid-template-columns: 1.05fr 1fr; }
        .nv-grid-2 { grid-template-columns: 1fr 1fr; }
      }

      @media (prefers-reduced-motion: reduce) {
        .nv-reveal, .nv-lift-lg, .nv-nav { transition: none; animation: none; }
      }
    </style>
  </body>
</html>
